#!/bin/sh
set -eu

usage() {
    cat <<'USAGE'
usage:
  scripts/release-notes [REF]
  scripts/release-notes --range PREV..REF

Print Markdown release notes using the subject of every commit in the range.

With no REF, REF defaults to HEAD.
The generated range is the previous reachable tag before REF to REF.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "${1:-}" = "--range" ]; then
    if [ $# -ne 2 ]; then
        usage >&2
        exit 2
    fi
    range="$2"
else
    if [ $# -gt 1 ]; then
        usage >&2
        exit 2
    fi

    ref="${1:-HEAD}"
    if prev="$(git describe --tags --abbrev=0 "$ref^" 2>/dev/null)"; then
        range="$prev..$ref"
    else
        range="$ref"
    fi
fi

git log --reverse --format='- %s' "$range"
